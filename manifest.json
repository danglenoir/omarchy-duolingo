{
  "schemaVersion": 1,
  "id": "danglenoir.duolingo",
  "name": "Duolingo",
  "version": "1.0.0",
  "author": "danglenoir",
  "license": "MIT",
  "description": "Your Duolingo streak and learning stats in the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Duolingo",
    "description": "Shows your streak, daily lesson status, course XP, currencies, energy, and league standing.",
    "category": "Info",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalMinutes": 10
    },
    "schema": [
      {
        "key": "refreshIntervalMinutes",
        "type": "integer",
        "label": "Refresh interval (minutes)",
        "min": 1,
        "max": 60,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
